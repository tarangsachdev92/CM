{
  "version": "1.1.0",
  "library": "command-center-ui",
  "provider": "material-ui",
  "futureProvider": "command-center-ui",
  "description": "Component manifest aligned with orchestration/registries/ui_components.yaml. Swap provider in ui_library.yaml when Command Center design system is wired.",
  "components": {
    "ui.text": {
      "type": "Text",
      "category": "display",
      "uiComponent": "Text / Heading"
    },
    "ui.markdown": {
      "type": "Markdown",
      "category": "display",
      "uiComponent": "Box + react-markdown"
    },
    "ui.button": {
      "type": "Button",
      "category": "action",
      "uiComponent": "Button"
    },
    "ui.dropdown": {
      "type": "Dropdown",
      "category": "input",
      "uiComponent": "Select"
    },
    "ui.textbox": {
      "type": "Textbox",
      "category": "input",
      "uiComponent": "Input"
    },
    "ui.chart": {
      "type": "Chart",
      "category": "visualization",
      "uiComponent": "Box + Recharts"
    },
    "ui.kpicard": {
      "type": "KPICard",
      "category": "visualization",
      "uiComponent": "Box + Recharts"
    },
    "ui.table": {
      "type": "DataTable",
      "category": "visualization",
      "uiComponent": "Table"
    },
    "ui.alert": {
      "type": "Alert",
      "category": "feedback",
      "uiComponent": "Alert"
    },
    "ui.card": {
      "type": "Card",
      "category": "layout",
      "uiComponent": "Card"
    },
    "ui.vertical_stack": {
      "type": "VerticalStack",
      "category": "layout",
      "uiComponent": "VStack"
    },
     "ui.kg_results": {
      "type": "KgResults",
      "category": "visualization",
      "chakraComponent": "Box + Table + Recharts + Download"
    },
    "ui.suggestions": {
      "type": "Suggestions",
      "category": "visualization",
      "chakraComponent": "Box + Table + Recharts + Download"
    }
  }
}
